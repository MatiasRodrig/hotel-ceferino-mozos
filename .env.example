# ═════════════════════════════════════════════════════════════════════════════
# HOTEL CEFERINO MOZOS — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copie este archivo como `.env` antes de compilar en el VPS:
#   cp .env.example .env
# ═════════════════════════════════════════════════════════════════════════════

# Puerto del servidor Vite
VITE_PORT=3001

# URL pública donde corre `hotel-ceferino-api`
# - Si usa dominios separados: VITE_API_URL=https://api.tudominio.com
# - Si usa Nginx en el mismo dominio redirigiendo /api y /hubs: dejar vacío
VITE_API_URL=https://api.tudominio.com

# Destino del proxy interno de Vite (para desarrollo o vite preview)
VITE_API_PROXY_TARGET=http://localhost:5000
